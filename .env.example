# Server port used by npm run start/dev.
PORT=4173

# Optional. Defaults to ./data.
# Use an absolute path on production hosts if app files are read-only.
APP_DATA_DIR=./data

# Optional upload limit per image in megabytes.
MAX_UPLOAD_MB=6

# Optional private CV upload limit in megabytes (PDF or DOCX).
MAX_CV_UPLOAD_MB=8

# Storage backend. Use "local" for development or "supabase" for real deployment.
APP_STORAGE_DRIVER=local

# Indicador independente de pontualidade. Em Supabase fica desligado por omissão.
# Ativar apenas após aplicar a migração de pontualidade e concluir a avaliação
# jurídica/privacidade com informação adequada aos trabalhadores.
PUNCTUALITY_ENABLED=false

# Required when APP_STORAGE_DRIVER=supabase.
# Use the Project URL from Supabase settings.
SUPABASE_URL=

# Required when APP_STORAGE_DRIVER=supabase.
# Server-only service role key. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Private Supabase Storage bucket created by the migration.
SUPABASE_EVIDENCE_BUCKET=meo-evidence

# Review and retention periods for employment evaluations and access requests.
EVALUATION_REVIEW_MONTHS=12
EMPLOYMENT_DATA_RETENTION_YEARS=6
ACCESS_REQUEST_DAYS=30

# Required for Vercel Cron or any external scheduler calling scheduled maintenance.
# Use a long random value and send it as: Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Optional Google OAuth login.
# Create credentials in Google Cloud and authorize:
# http://localhost:4173/api/auth/google/callback
# http://127.0.0.1:4173/api/auth/google/callback
# https://your-production-domain/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. If empty, the server derives this from the request origin.
GOOGLE_REDIRECT_URI=

# Optional public origin used for canonical URLs, robots.txt, sitemap.xml,
# and server-rendered SEO pages. If empty, the server derives it from the request.
PUBLIC_SITE_URL=

# Optional opt-in Web Push. Generate a single VAPID key pair with
# `npx web-push generate-vapid-keys --json`; keep the private key server-only.
# Apply supabase/migrations/20261023180000_important_web_push.sql first.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
PLATFORM_ADMIN_USER_IDS=
PLATFORM_ADMIN_EMAILS=

# Comma-separated existing user IDs allowed to moderate the recruitment platform.
# Never assign platform privileges from browser input or company-managed roles.
PLATFORM_ADMIN_USER_IDS=

# Optional email job alerts. Use a verified sender address; cron delivers saved searches.
RESEND_API_KEY=
EMAIL_FROM=
